# Frontend build setting; the API URL is public, not a secret.
VITE_API_BASE_URL=http://127.0.0.1:3001
# Backend settings. Use Render's internal connection URL in the same region.
DATABASE_URL=postgres://postgres:your-local-password@127.0.0.1:5432/qihuang
ALLOWED_ORIGINS=http://127.0.0.1:5173
PORT=3001
# Optional: promote ONLY this already registered account during startup.
# Leave blank on a fresh database; register the owner first, then configure and redeploy.
INITIAL_ADMIN_USERNAME=

# AI model keys are encrypted on the backend. Supply a private 32-byte base64 key.
# Leave blank to disable model configuration until encryption is provisioned.
AI_CONFIG_ENCRYPTION_KEY=
